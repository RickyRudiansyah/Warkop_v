# Dependencies — reinstalled inside the image
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output — regenerated inside the image
.next
out
build

# Env & secrets — provided at build/run time, never baked into the image
.env
.env.*
!.env.example

# Version control & editor
.git
.gitignore
.vscode
.idea

# Misc
.DS_Store
*.pem
README.md
*.tsbuildinfo

# Local-only scripts / SQL (not needed in the runtime image)
scripts

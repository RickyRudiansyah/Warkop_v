# ---- Supabase (public — safe to expose to the browser) ----
# Baked into the client bundle at BUILD time.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (secret — server only) ----
# Read at RUNTIME. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Geolocation gate (customer order page) ----
# Master switch: "true" blocks customers who are far from the café, anything
# else (or unset) disables the check entirely.
NEXT_PUBLIC_LOCATION_CHECK=false
# Get coordinates from Google Maps: right-click the café location → copy lat,lng
NEXT_PUBLIC_CAFE_LAT=-6.175005266751446
NEXT_PUBLIC_CAFE_LNG=106.68476665889558
NEXT_PUBLIC_CAFE_RADIUS_METERS=200

# ---- Sakelar QRIS pelanggan ----
# false / kosong = pilihan QRIS di checkout tampil MATI ("Belum tersedia") dan
#   POST /api/payments/mayar/create menolak dengan 503. Ini defaultnya.
# true = QRIS aktif — hanya berlaku kalau MAYAR_API_KEY di bawah juga terisi.
# NEXT_PUBLIC_* di-bake saat build: ubah nilainya lalu DEPLOY ULANG.
# Catatan: ini tidak menyentuh pilihan "QRIS" di POS kasir — di sana artinya
# uangnya sudah diterima lewat cara lain, tidak ada gateway yang dipanggil.
NEXT_PUBLIC_QRIS_ENABLED=false

# ---- Mayar QRIS payment gateway (active provider) ----
# API key from the Mayar dashboard. Production key -> api.mayar.id (set IS_PRODUCTION=true),
# sandbox key -> api.mayar.club (IS_PRODUCTION=false).
# Optional webhook: set the URL in Mayar to <your-domain>/api/payments/mayar/webhook
MAYAR_API_KEY=your-mayar-api-key
MAYAR_IS_PRODUCTION=false

# ---- Midtrans QRIS payment gateway (legacy / unused) ----
# Server key from the Midtrans dashboard -> Settings -> Access Keys.
#   Sandbox key looks like  SB-Mid-server-xxxx  -> set MIDTRANS_IS_PRODUCTION=false
#   Production key looks like   Mid-server-xxxx  -> set MIDTRANS_IS_PRODUCTION=true
# QRIS must be activated for your account, and set the Payment Notification URL to
#   <your-public-domain>/api/payments/midtrans/webhook
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# ---- Printer struk Bluetooth (aplikasi Android companion) ----
# Token bersama yang dipakai aplikasi Android untuk menarik antrian cetak.
# Kirim sebagai header:  x-print-token: <token>
# Buat token acak, mis:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PRINT_DEVICE_TOKEN=

# Kop & kaki struk
RECEIPT_STORE_NAME=Rumipang
RECEIPT_STORE_ADDRESS=
RECEIPT_STORE_PHONE=
RECEIPT_FOOTER=Terima kasih atas kunjungan Anda!
# Lebar kertas: 32 = 58mm (default), 48 = 80mm
RECEIPT_COLUMNS=32
